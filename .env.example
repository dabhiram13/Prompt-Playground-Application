# ──────────────────────────────────────────────────────────────────────
# Required for OpenRouter models — get a FREE key at https://openrouter.ai/keys
# The default model list uses only ":free" models, so your spend stays $0.
# (Run Ollama locally instead and you don't need a key at all.)
# ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Optional — port for the dev server (default: 3000)
# PORT=3000

# Optional — opt in to paid models in the model menu (default: off)
# ALLOW_PAID_MODELS=1

# Optional — override the default/judge models (must be in the allowlist)
# DEFAULT_MODEL=openai/gpt-oss-120b:free
# JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional — SQLite location. In production point this at a mounted volume
# (e.g. Railway volume at /data) or user data is wiped on every redeploy!
# DATABASE_PATH=/data/prompt_studio.db

# Optional — public mini-app abuse controls (sane defaults built in)
# PUBLIC_IP_MAX_REQUESTS=10
# PUBLIC_APP_DAILY_TOKENS=200000
# PUBLIC_GLOBAL_DAILY_TOKENS=1000000
# PUBLIC_APPS_DISABLED=1   # kill switch
